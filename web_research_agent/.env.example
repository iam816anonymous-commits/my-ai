# ==================================================
# Web Research Agent Configuration
# ==================================================

# OpenRouter API Key
# Get one from https://openrouter.ai/keys
API_KEY=your_openrouter_api_key_here

# OpenRouter Base URL
BASE_URL=https://openrouter.ai/api/v1

# Default Model
# Can be changed without modifying code.
MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b:free

# ==================================================
# Research Configuration
# ==================================================

# Maximum reasoning iterations
MAX_ITERATIONS=3

# Maximum search results to process
MAX_SEARCH_RESULTS=5

# Maximum extracted characters per page
MAX_ARTICLE_CHARS=4000

# LLM retry attempts
MAX_RETRIES=3

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# ==================================================
# Logging
# ==================================================

LOG_LEVEL=INFO

# DEBUG | INFO | WARNING | ERROR
DEBUG=false

# ==================================================
# Optional OpenRouter Headers
# ==================================================

# These improve attribution on OpenRouter.
# Leave blank if not needed.

HTTP_REFERER=
X_TITLE=Web Research Agent
