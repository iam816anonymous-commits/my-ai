# ==================================================
# Web Research Agent Configuration
# ==================================================

# OpenRouter API Key
API_KEY=your_openrouter_api_key_here

# Provider Settings
BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b:free

# ==================================================
# Research Loop Configuration
# ==================================================

# Maximum reasoning iterations (1-5)
MAX_ITERATIONS=3

# Maximum search results to process per cycle
MAX_SEARCH_RESULTS=5

# Maximum extracted characters per page
MAX_ARTICLE_CHARS=4000

# Targeted summary length (words)
MAX_SUMMARY_WORDS=250

# LLM retry attempts
MAX_RETRIES=3

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# Parallel processing workers
CONCURRENCY=5

# Stopping threshold for objective coverage (0-100)
CONFIDENCE_THRESHOLD=90

# ==================================================
# Output & Traceability
# ==================================================

# Generate detailed trace.md for debugging
TRACE_MODE=true

# Comma-separated list: markdown,json,html
EXPORT_FORMATS=markdown,json,html

# ==================================================
# Logging
# ==================================================

LOG_LEVEL=INFO
DEBUG=false

# ==================================================
# Optional OpenRouter Headers
# ==================================================

HTTP_REFERER=
X_TITLE=Web Research Agent
